# Copy to .env and fill in:  cp .env.example .env
# Without a .env everything runs locally: Ollama + MailHog (nothing leaves your machine).

# --- AI model (any OpenAI-compatible API) ------------------------------------
# Local Ollama by default. Works with OpenAI, Groq, OpenRouter, LM Studio, etc.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
# Example for OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Mail (SMTP) ---------------------------------------------------------------
# MailHog by default (test inbox at http://localhost:8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=ai-router@example.com
SMTP_USER=
SMTP_PASSWORD=
# none | starttls | ssl
SMTP_SECURITY=none
# Example for Gmail (requires an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Example for Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls

# --- API security ----------------------------------------------------------------
# If set, every request must include the header  X-API-Key: <value>
API_KEY=

# --- Department config -------------------------------------------------------
DEPARTMENTS_FILE=/config/departments.yaml
