# Skopiuj do .env i uzupelnij:  cp .env.example .env
# Bez .env wszystko dziala lokalnie: Ollama + MailHog (nic nie wychodzi na zewnatrz).

# --- Model AI (dowolne API zgodne z OpenAI) ---------------------------------
# Domyslnie lokalna Ollama. Mozna podpiac OpenAI, Groq, OpenRouter, LM Studio itd.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
# Przyklad dla OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Poczta (SMTP) --------------------------------------------------------------
# Domyslnie MailHog (testowa skrzynka na http://localhost:8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=ai-router@example.com
SMTP_USER=
SMTP_PASSWORD=
# none | starttls | ssl
SMTP_SECURITY=none
# Przyklad dla Gmaila (wymaga hasla aplikacji):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# Przyklad dla Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls

# --- Bezpieczenstwo API ----------------------------------------------------------
# Jesli ustawione, kazde zapytanie musi miec naglowek  X-API-Key: <wartosc>
API_KEY=

# --- Konfiguracja dzialow ----------------------------------------------------
DEPARTMENTS_FILE=/config/departments.yaml
